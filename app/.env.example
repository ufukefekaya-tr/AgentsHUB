# AgentsHUB — Environment Variables Template
# Kopyalayın: cp .env.example .env

# ─── Sunucu ───────────────────────────────────────────────
UI_PORT=3434
NODE_ENV=production
CORS_ORIGINS=http://localhost:3434

# ─── Güvenlik ─────────────────────────────────────────────
# Dashboard API erişim anahtarı (rastgele bir string oluşturun)
UI_API_KEY=your_secure_api_key_here

# JWT Secret (rastgele 64+ karakter)
JWT_SECRET=generate_a_long_random_secret_here

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_CHAT=60
RATE_LIMIT_API=300

# ─── Opsiyonel: Arama API'leri ───────────────────────────
# Tavily AI Search (https://tavily.com)
# TAVILY_API_KEY=tvly-xxxxx

# Brave Search API (https://brave.com/search/api/)
# BRAVE_API_KEY=BSAxxxxx

# ─── Opsiyonel: Diğer Entegrasyonlar ─────────────────────
# GitHub Personal Access Token
# GITHUB_TOKEN=ghp_xxxxx

# Telegram Bot Token
# TELEGRAM_BOT_TOKEN=xxxxx:xxxxx

# SMTP (E-posta gönderme)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password